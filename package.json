{
	"name": "neko-harness",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"check": "biome check . && tsc --noEmit",
		"check:write": "biome check --write . && tsc --noEmit",
		"test": "vitest run",
		"neko": "tsx packages/cli/src/main.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.20.5",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
